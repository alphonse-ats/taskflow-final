<header class="navbar">
  <a href="/" class="brand">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="3" y="3" width="18" height="18" rx="5" fill="#6366f1"/>
      <path d="M8 12l3 3 5-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    TaskFlow
  </a>
  <nav>
    <% if (user) { %>
      <a href="/tasks">Mis Tareas</a>
      <span class="user-chip">
        👤 <%= user.name %>
        <span class="role"><%= user.role %></span>
      </span>
      <form action="/auth/logout" method="POST" style="display:inline;margin:0">
        <button type="submit" class="btn-logout">Salir</button>
      </form>
    <% } else { %>
      <a href="/auth/login">Iniciar sesión</a>
      <a href="/auth/register" class="btn" style="padding:.5rem 1rem">Registrarse</a>
    <% } %>
  </nav>
</header>